<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cosmos - Space Exploration</title>

  <!-- Bootstrap 5 CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>
    /* Smooth scrolling when clicking nav links */
    html {
      scroll-behavior: smooth;
    }

    /* Offset for sticky navbar */
    section {
      padding-top: 80px;
      padding-bottom: 60px;
    }

    .hero-section {
      min-height: 100vh;
      background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.85)),
        url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1600&q=80')
          center/cover no-repeat;
    }

    .planet-card img {
      height: 200px;
      object-fit: cover;
    }
  </style>
</head>
<body class="bg-dark text-light">

  <!-- ================= NAVBAR ================= -->
  <!-- 'navbar-expand-lg' collapses the menu into 3 lines (hamburger) on smaller screens like Android/iOS -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary fixed-top">
    <div class="container">
      <a class="navbar-brand fw-bold text-info" href="#home">COSMOS</a>

      <!-- Hamburger Button (Three Lines) -->
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#spaceNavbar"
        aria-controls="spaceNavbar"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <!-- Nav Links -->
      <div class="collapse navbar-collapse" id="spaceNavbar">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link active" href="#home">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#about">About Space</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#planets">Planets</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#missions">Missions</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#contact">Contact</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- ================= HERO / HOME SECTION ================= -->
  <section id="home" class="hero-section d-flex align-items-center">
    <div class="container text-center">
      <h1 class="display-3 fw-bold text-white mb-3">Journey Across The Stars</h1>
      <p class="lead text-secondary mb-4 mx-auto" style="max-width: 650px;">
        Explore distant worlds, deep space discoveries, and planetary science right from your screen.
      </p>
      <a href="#planets" class="btn btn-info btn-lg px-4 me-2 text-dark fw-semibold">Explore Planets</a>
      <a href="#about" class="btn btn-outline-light btn-lg px-4">Learn More</a>
    </div>
  </section>

  <!-- ================= ABOUT SECTION ================= -->
  <section id="about" class="bg-dark text-white border-bottom border-secondary">
    <div class="container">
      <div class="row align-items-center g-4">
        <div class="col-lg-6">
          <span class="text-info fw-bold text-uppercase">Discovery</span>
          <h2 class="display-5 fw-bold mt-2">The Vast Frontier of Space</h2>
          <p class="text-secondary mt-3">
            Space begins around 100 kilometers (62 miles) above Earth at the Kármán line. Beyond this threshold lies a vacuum filled with billions of galaxies, dark matter, and unexplored stellar bodies.
          </p>
          <p class="text-secondary">
            Modern telescopes and interplanetary probes allow us to observe exoplanets hundreds of light-years away and study cosmic evolution directly.
          </p>
        </div>
        <div class="col-lg-6 text-center">
          <img
            src="https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?auto=format&fit=crop&w=800&q=80"
            alt="Earth from orbit"
            class="img-fluid rounded-3 shadow border border-secondary"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PLANETS SECTION ================= -->
  <section id="planets" class="bg-black text-white border-bottom border-secondary">
    <div class="container">
      <div class="text-center mb-5">
        <span class="text-info fw-bold text-uppercase">Solar System</span>
        <h2 class="display-5 fw-bold mt-2">Notable Worlds</h2>
        <p class="text-secondary mx-auto" style="max-width: 600px;">
          A quick look at three distinct bodies orbiting our home star.
        </p>
      </div>

      <div class="row g-4">
        <!-- Mars -->
        <div class="col-md-4">
          <div class="card h-100 bg-dark text-light border-secondary planet-card">
            <img
              src="https://images.unsplash.com/photo-1614728894747-a83421e2b9c9?auto=format&fit=crop&w=600&q=80"
              class="card-img-top"
              alt="Mars"
            />
            <div class="card-body">
              <h5 class="card-title fw-bold text-danger">Mars</h5>
              <p class="card-text text-secondary">
                Known as the Red Planet due to iron oxide on its surface. It hosts Olympus Mons, the largest volcano in the solar system.
              </p>
            </div>
            <div class="card-footer border-secondary text-secondary small">
              Distance from Sun: ~228M km
            </div>
          </div>
        </div>

        <!-- Jupiter -->
        <div class="col-md-4">
          <div class="card h-100 bg-dark text-light border-secondary planet-card">
            <img
              src="https://images.unsplash.com/photo-1630839437035-dac17da580d0?auto=format&fit=crop&w=600&q=80"
              class="card-img-top"
              alt="Jupiter"
            />
            <div class="card-body">
              <h5 class="card-title fw-bold text-warning">Jupiter</h5>
              <p class="card-text text-secondary">
                The largest planet in our solar system, with a mass more than two and a half times that of all other planets combined.
              </p>
            </div>
            <div class="card-footer border-secondary text-secondary small">
              Distance from Sun: ~778M km
            </div>
          </div>
        </div>

        <!-- Saturn -->
        <div class="col-md-4">
          <div class="card h-100 bg-dark text-light border-secondary planet-card">
            <img
              src="https://images.unsplash.com/photo-1614732414444-096e5f1122d5?auto=format&fit=crop&w=600&q=80"
              class="card-img-top"
              alt="Saturn"
            />
            <div class="card-body">
              <h5 class="card-title fw-bold text-info">Saturn</h5>
              <p class="card-text text-secondary">
                Famous for its extensive ring system made of billions of small chunks of ice and rock orbiting the gas giant.
              </p>
            </div>
            <div class="card-footer border-secondary text-secondary small">
              Distance from Sun: ~1.4B km
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MISSIONS SECTION ================= -->
  <section id="missions" class="bg-dark text-white border-bottom border-secondary">
    <div class="container">
      <div class="text-center mb-5">
        <span class="text-info fw-bold text-uppercase">Exploration</span>
        <h2 class="display-5 fw-bold mt-2">Active Spacecraft</h2>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <div class="p-4 bg-black border border-secondary rounded-3">
            <h4 class="text-info">James Webb Space Telescope</h4>
            <p class="text-secondary mb-0">
              Operating at Lagrange Point 2, studying the earliest stars, galaxy formation, and atmospheric compositions of exoplanets.
            </p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-4 bg-black border border-secondary rounded-3">
            <h4 class="text-info">Perseverance Rover</h4>
            <p class="text-secondary mb-0">
              Analyzing rock samples in Jezero Crater on Mars to search for signs of ancient microbial life and test oxygen production.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CONTACT / FOOTER ================= -->
  <footer id="contact" class="bg-black py-5 text-secondary text-center">
    <div class="container">
      <p class="mb-2 text-white fw-bold">COSMOS Space Explorer</p>
      <p class="small mb-0">Built with HTML5 & Bootstrap 5</p>
    </div>
  </footer>

  <!-- Bootstrap 5 JavaScript Bundle (Includes Popper for Navbar collapse/three-line toggler) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Optional script: Auto-close hamburger menu on mobile when a link is clicked -->
  <script>
    const navLinks = document.querySelectorAll('.nav-link');
    const menuToggle = document.getElementById('spaceNavbar');
    const bsCollapse = new bootstrap.Collapse(menuToggle, { toggle: false });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 992) {
          bsCollapse.hide();
        }
      });
    });
  </script>
</body>
</html>
